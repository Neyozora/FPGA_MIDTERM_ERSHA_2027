# ==============================================================================
# Quartus Prime Settings File (.qsf) — Standalone cnn_top Synthesis
# Device: Intel Cyclone V SoC (5CSXFC6D6F31C6)
# ==============================================================================

set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSXFC6D6F31C6
set_global_assignment -name TOP_LEVEL_ENTITY cnn_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 18.1.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "20:00:00  NOVEMBER 16, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "18.1.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name SEARCH_PATH ..

set_global_assignment -name VERILOG_FILE ../rtl/conv_engine.v
set_global_assignment -name VERILOG_FILE ../rtl/relu.v
set_global_assignment -name VERILOG_FILE ../rtl/maxpool.v
set_global_assignment -name VERILOG_FILE ../rtl/gap.v
set_global_assignment -name VERILOG_FILE ../rtl/fully_connected.v
set_global_assignment -name VERILOG_FILE ../rtl/argmax.v
set_global_assignment -name VERILOG_FILE ../rtl/cnn_top.v
set_global_assignment -name SDC_FILE cnn_top.sdc

set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
