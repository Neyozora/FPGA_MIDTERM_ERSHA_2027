# ==============================================================================
# Quartus Prime Settings File (.qsf) — Method 2 (CIFAR-10 RGB Parallel CNN)
# Device: Intel Cyclone V SX SoC (5CSXFC6D6F31C6)
# Top-Level Entity: de10_standard_top_m2
# ==============================================================================

set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSXFC6D6F31C6
set_global_assignment -name TOP_LEVEL_ENTITY de10_standard_top_m2
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 18.1.0
set_global_assignment -name LAST_QUARTUS_VERSION "18.1.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name SEARCH_PATH ..

# RTL & Constraints
set_global_assignment -name VERILOG_FILE ../rtl_m2/conv_engine_m2.v
set_global_assignment -name VERILOG_FILE ../rtl_m2/maxpool_m2.v
set_global_assignment -name VERILOG_FILE ../rtl_m2/gap_fc_argmax_m2.v
set_global_assignment -name VERILOG_FILE ../rtl_m2/cnn_top_m2.v
set_global_assignment -name VERILOG_FILE ../rtl_m2/vga_cnn_hud_m2.v
set_global_assignment -name VERILOG_FILE ../rtl_m2/de10_standard_top_m2.v
set_global_assignment -name QIP_FILE hps_cnn_qsys/synthesis/hps_cnn_qsys.qip
set_global_assignment -name SDC_FILE de10_standard_m2.sdc

# 50 MHz Clock
set_location_assignment PIN_AF14 -to CLOCK_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLOCK_50

# Pushbuttons KEY[3:0]
set_location_assignment PIN_AJ4 -to KEY[0]
set_location_assignment PIN_AK4 -to KEY[1]
set_location_assignment PIN_AA14 -to KEY[2]
set_location_assignment PIN_AA15 -to KEY[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KEY[*]

# Slide Switches SW[9:0]
set_location_assignment PIN_AB30 -to SW[0]
set_location_assignment PIN_Y27 -to SW[1]
set_location_assignment PIN_AB28 -to SW[2]
set_location_assignment PIN_AC30 -to SW[3]
set_location_assignment PIN_W25 -to SW[4]
